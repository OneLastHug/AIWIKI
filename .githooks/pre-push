#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

blocked_pattern='^(data/generated/|data/repos/|data/service\.sqlite3($|-)|cache/)'
allowed_pattern='^(data/generated/\.gitkeep|data/repos/\.gitkeep)$'

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  changed=$(git diff --name-status "$range" || true)
  blocked=$(printf '%s\n' "$changed" | awk '$1 != "D" {print $2}' | grep -E "$blocked_pattern" | grep -Ev "$allowed_pattern" || true)
  if [ -n "$blocked" ]; then
    echo "Refusing push: commit range contains local-only analysis artifacts or mirrored source:" >&2
    echo "$blocked" >&2
    echo "Remove them from git history for this push before publishing." >&2
    exit 1
  fi
done
